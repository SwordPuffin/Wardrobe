#: data/io.github.swordpuffin.wardrobe.desktop.in:2
#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:7
msgid "Wardrobe"
msgstr "Gardırop"

#: data/io.github.swordpuffin.wardrobe.desktop.in:8
msgid "wardrobe;appearance;gtk;gnome;icon;wallpaper;shell;"
msgstr "gardırop;görünüm;gtk;gnome;simge;duvar kağıdı;kabuk;"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:8
msgid "Gnome customization made easy"
msgstr "Gnome özelleştirme artık çok kolay"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:10
msgid ""
"Wardrobe is a utility for downloading community made Gnome Shell, Gtk3/4, "
"icon, and cursor themes as well as wallpapers"
msgstr ""
"Gardırop, kullanıcılar tarafından oluşturulan Gnome Kabuk, Gtk3/4, simge ve imleç "
"temalarının yanı sıra duvar kağıtlarını indirmek için kullanılan bir yardımcı programdır"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:11
msgid ""
"**This app has not been tested for any desktop environments other than "
"Gnome, so do not expect it to fully work in Cinnamon, Xfce, etc.**"
msgstr ""
"**Bu uygulama Gnome dışındaki masaüstü ortamlarında test edilmemiştir; "
"bu nedenle Cinnamon, Xfce vb. ortamlarda tam olarak çalışmasını beklemeyin.**"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:15
msgid "Nathan Perlman"
msgstr "Nathan Perlman"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:33
msgid "Browsing for shell themes"
msgstr "Kabuk temalarına göz atılıyor"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:37
msgid "Downloading the Papirus icon pack"
msgstr "Papirus simge paketi indiriliyor"

#: data/io.github.swordpuffin.wardrobe.metainfo.xml.in:41
msgid "Searching for a keyword"
msgstr "Anahtar kelime aranıyor"

